# ---------------------------------------------------------------------------
# IELTS Pulse — environment variables
# Copy to `.env.local` for local dev. In Railway, set these under
# Project → Variables. Without them the app runs on bundled mock data.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# (Supabase dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser (RLS-enforced).
# (Project Settings → API → Project API keys → anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, never expose to the browser. Used for
# server-side data reads/writes until end-user auth is wired.
# (Project Settings → API → Project API keys → service_role / secret)
SUPABASE_SERVICE_ROLE_KEY=
