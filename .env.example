# ---------------------------------------------------------------------------
# IELTS Pulse — environment variables
# Copy to `.env.local` for local dev. In Railway, set these under
# Project → Variables. Without them the app runs on bundled mock data.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# (Supabase dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser (RLS-enforced).
# (Project Settings → API → Project API keys → anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, never expose to the browser. Bypasses RLS;
# used for seeds and whole-centre aggregates. User-facing reads go through the
# session (RLS), not this key.
# (Project Settings → API → Project API keys → service_role / secret)
SUPABASE_SERVICE_ROLE_KEY=

# Demo mode — a client-facing showcase, OFF by default. When on, the login
# page shows "Войти в демо-режим" and that session is served entirely from the
# bundled fixtures (lib/mock-data, lib/group-data, lib/admin-data). A demo
# session never reads or writes the centre's database, so it is safe to enable
# on a live deployment and works even before any real data exists.
# DEMO_MODE gates the server; NEXT_PUBLIC_DEMO_MODE gates the login-page UI —
# set both to "true" to enable.
DEMO_MODE=
NEXT_PUBLIC_DEMO_MODE=

# Password for the seeded test accounts (scripts/seed-users.mjs). Required at
# seed time only; never committed. e.g. SEED_PASSWORD=change-me-8+chars
SEED_PASSWORD=

# Anthropic API key — powers the AI evaluation of Writing Task 2 essays.
# SERVER ONLY. Without it the evaluator reports that it is unconfigured rather
# than returning invented band scores. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
