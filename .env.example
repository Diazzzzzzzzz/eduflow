# ---------------------------------------------------------------------------
# IELTS Pulse — environment variables
# Copy to `.env.local` for local dev. In Railway, set these under
# Project → Variables. Without them the app runs on bundled mock data.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# (Supabase dashboard → Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser (RLS-enforced).
# (Project Settings → API → Project API keys → anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, never expose to the browser. Bypasses RLS;
# used for seeds and whole-centre aggregates. User-facing reads go through the
# session (RLS), not this key.
# (Project Settings → API → Project API keys → service_role / secret)
SUPABASE_SERVICE_ROLE_KEY=

# Demo one-click login. OFF by default and ALWAYS disabled in production
# (NODE_ENV=production). Set both to "true" for a demo/dev build. DEMO_MODE
# gates the server; NEXT_PUBLIC_DEMO_MODE gates the login-page buttons.
DEMO_MODE=
NEXT_PUBLIC_DEMO_MODE=

# Password for the seeded test accounts (scripts/seed-users.mjs). Required at
# seed time only; never committed. e.g. SEED_PASSWORD=change-me-8+chars
SEED_PASSWORD=
